{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hanoi-temp",
  "main": "src/entry.py",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": ["python_workers"],
  "observability": {"enabled": true},
  "d1_databases": [{
    "binding": "DB",
    "database_name": "hanoi-temp",
    "database_id": "08aa32e3-034c-48cc-8e3b-2de538591d0a",
    // Preserve the existing seeded local database during development.
    "preview_database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  // Midnight and noon Hanoi (17:00 and 05:00 UTC).
  "triggers": {"crons": ["0 5,17 * * *"]}
}
